---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildMetadata } from '../lib/seo/metadata';

const metadata = buildMetadata({
  pathname: '/cookie-notice',
  title: 'Cookie and Analytics Notice',
  description: 'OZMO Digital analytics and cookie notice for a cookie-free Plausible setup.',
  imagePath: '/assets/og-default.png',
});
---

<BaseLayout metadata={metadata}>
  <section class="policy-shell">
    <p class="eyebrow">Legal approval required before production launch</p>
    <h1>Cookie and Analytics Notice</h1>
    <p>
      V1 is planned around cookie-free Plausible Analytics. This route will hold owner-approved
      notice copy before production launch.
    </p>
  </section>
</BaseLayout>

<style>
  .policy-shell {
    width: min(780px, calc(100% - 2rem));
    min-height: 52vh;
    margin: 0 auto;
    padding: var(--space-16) 0;
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-action-orange-dark);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 8vw, 4.8rem);
    line-height: 0.98;
  }

  p {
    color: var(--color-muted-ink);
    font-size: 1.15rem;
  }
</style>
