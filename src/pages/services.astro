---
import ServiceCard from '../components/content/ServiceCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildMetadata } from '../lib/seo/metadata';
import { buildOrganizationSchema, buildServiceSchema } from '../lib/seo/schema';
import { getBuildServices } from '../lib/wordpress/content';

const services = await getBuildServices();
const metadata = buildMetadata({
  pathname: '/services',
  title: 'Services',
  description:
    'Website design, redesign, messaging, SEO, forms, and ongoing care for faster, clearer lead paths.',
  imagePath: '/assets/og-services.png',
});
const serviceSchemas = services.map((service) =>
  buildServiceSchema({
    name: service.title,
    description: service.summary,
    url: `${metadata.canonical}#${service.slug}`,
  }),
);
---

<BaseLayout metadata={metadata} jsonLd={[buildOrganizationSchema(), ...serviceSchemas]}>
  <section class="page-hero" aria-labelledby="services-title">
    <div class="hero-shell">
      <p class="eyebrow">Services</p>
      <h1 id="services-title">Services for faster, clearer lead paths</h1>
      <p>
        OZMO Digital builds the website layer small businesses need before referrals, search,
        social traffic, or paid campaigns can turn into useful conversations.
      </p>
    </div>
  </section>

  <section class="service-list" aria-label="OZMO Digital services">
    <div class="service-grid">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </section>

  <section class="review-band" aria-labelledby="services-review-title">
    <div>
      <p class="eyebrow">Start with the current site</p>
      <h2 id="services-review-title">Find the friction before choosing the scope.</h2>
    </div>
    <a href="/free-site-audit">Get a Free Site Review</a>
  </section>
</BaseLayout>

<style>
  .page-hero,
  .service-list {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .page-hero {
    padding: clamp(3rem, 7vw, 5.5rem) 0 var(--space-12);
  }

  .hero-shell {
    max-width: 58rem;
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-action-orange-dark);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  h1,
  h2,
  p {
    margin: 0;
  }

  h1,
  h2 {
    color: var(--color-deep-ink);
    font-family: var(--font-display);
    line-height: 1.02;
  }

  h1 {
    max-width: 14ch;
    font-size: clamp(2.8rem, 8vw, 5.9rem);
  }

  h2 {
    max-width: 16ch;
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .hero-shell > p:last-child {
    max-width: 43rem;
    margin-top: var(--space-5);
    color: var(--color-muted-ink);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
  }

  .service-list {
    padding-bottom: var(--space-16);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .review-band {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto var(--space-16);
    padding: var(--space-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    background: var(--color-after-blue-soft);
    border: 1px solid color-mix(in srgb, var(--color-ozmo-blue) 22%, transparent);
    border-radius: var(--radius-md);
  }

  .review-band a {
    min-height: 48px;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-5);
    background: var(--color-action-orange-dark);
    color: var(--color-white);
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .service-grid {
      grid-template-columns: 1fr;
    }

    .review-band {
      align-items: flex-start;
      flex-direction: column;
      padding: var(--space-6);
    }
  }
</style>
