---
import type { PostViewModel } from '../../lib/wordpress/mappers';

type Props = {
  post: PostViewModel;
};

const { post } = Astro.props;
const publishedDate = new Date(post.publishedAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<article class="blog-card" data-testid="blog-card">
  <time datetime={post.publishedAt}>{publishedDate}</time>
  <h3>
    <a href={post.canonicalPath}>{post.title}</a>
  </h3>
  <p>{post.excerpt}</p>
  <a class="read-link" href={post.canonicalPath}>Read note</a>
</article>

<style>
  .blog-card {
    min-height: 100%;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
    background: var(--color-white);
    border: 1px solid color-mix(in srgb, var(--color-line-gray) 74%, transparent);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 34px color-mix(in srgb, var(--color-deep-ink) 7%, transparent);
  }

  time {
    color: var(--color-ozmo-blue);
    font-size: 0.88rem;
    font-weight: 600;
  }

  h3,
  p {
    margin: 0;
  }

  h3 {
    color: var(--color-deep-ink);
    font-family: var(--font-display);
    font-size: 1.28rem;
    line-height: 1.1;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-ozmo-blue);
  }

  p {
    color: var(--color-muted-ink);
  }

  .read-link {
    width: fit-content;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--color-action-orange-dark);
    font-weight: 600;
  }
</style>
