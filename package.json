{
  "name": "ozmo-redesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "OZMO_ALLOW_LOCAL_WORDPRESS_FIXTURES=true astro dev",
    "build": "OZMO_ALLOW_LOCAL_WORDPRESS_FIXTURES=true astro check && OZMO_ALLOW_LOCAL_WORDPRESS_FIXTURES=true astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve:dist": "env -u FORCE_COLOR -u NO_COLOR tsx scripts/serve-dist.ts",
    "test:e2e": "env -u FORCE_COLOR -u NO_COLOR playwright test",
    "test:a11y": "env -u FORCE_COLOR -u NO_COLOR playwright test tests/e2e/a11y.spec.ts",
    "test:lighthouse": "CHROME_PATH=$(node -e \"import('playwright').then(({ chromium }) => process.stdout.write(chromium.executablePath()))\") lhci autorun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "wp:validate": "vitest run tests/unit/wordpress",
    "assets:brand": "tsx scripts/build-brand-assets.ts",
    "verify": "npm run check && npm run test && npm run test:e2e && npm run test:lighthouse"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vercel": "11.0.5",
    "@auth/core": "0.41.3",
    "@auth/drizzle-adapter": "1.11.3",
    "@neondatabase/serverless": "1.1.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.2",
    "astro": "7.2.0",
    "drizzle-orm": "0.45.2",
    "luxon": "3.7.2",
    "resend": "6.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@fontsource/sora": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
